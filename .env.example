# ComeUpStartup Media - LOCAL DEVELOPMENT ONLY.
# Copy to .env and adjust. Never put production credentials in this file or in Docker config.

APP_NAME="ComeUpStartup Media"
APP_ENV=local
# Generate with: docker compose exec app php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_DEMO=false
DEFAULT_LANGUAGE=en

# CMS install state. 1 = installed (skip the web installer). Leave LICENSE_CHECKED empty
# locally so the ThemeLooks licence client makes no outbound calls.
IS_USER_REGISTERED=1
LICENSE_CHECKED=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose MariaDB service (see docker-compose.yml). Dev-only placeholder passwords.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=comeupstartup
DB_USERNAME=comeupstartup
DB_PASSWORD=dev-only-change-me
DB_ROOT_PASSWORD=dev-only-root-change-me
DB_TEST_DATABASE=comeupstartup_test

# Host ports and container user mapping
APP_PORT=8080
DB_FORWARD_PORT=33060
DOCKER_UID=1000
DOCKER_GID=1000

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Third-party integrations - leave empty locally unless you have dev/test credentials.
OPEN_AI_KEY=
GOOGLE_FONTS_API_KEY=
MAILCHIMP_APIKEY=
MAILCHIMP_LIST_ID=

# Generate with: docker compose exec app php artisan jwt:secret
JWT_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

DEBUGBAR_ENABLED=false
